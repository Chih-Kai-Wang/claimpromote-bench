{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimpromotebench.invalid/v2/schemas/local-model-run-record.schema.json",
  "title": "ClaimPromoteBenchLocalModelRunRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "frozen_plan_commit",
    "packet_sha256",
    "dataset_manifest_sha256",
    "phase",
    "lane_id",
    "provider",
    "model_requested",
    "model_returned",
    "model_family",
    "item_id",
    "pair_id",
    "request_sha256",
    "prompt_sha256",
    "response_format_sha256",
    "provider_response_id",
    "routed_provider",
    "system_fingerprint",
    "finish_reason",
    "request_started_at_utc",
    "response_received_at_utc",
    "transport_status",
    "transport_error",
    "raw_response_text",
    "raw_response_sha256",
    "parse_status",
    "parse_error_detail",
    "raw_decision",
    "postgate_decision",
    "latency_ms",
    "usage",
    "actual_cost_usd",
    "cost_status",
    "evidence_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "study_id": {"type": "string", "pattern": "^claimpromotebench-.+-local-model-replication-2026-08-v2$"},
    "frozen_plan_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "packet_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dataset_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "phase": {"const": "full"},
    "lane_id": {"type": "string", "pattern": "^local-mlx-.+-v2$"},
    "provider": {"const": "Local MLX"},
    "model_requested": {"type": "string", "minLength": 1},
    "model_returned": {"type": "string", "minLength": 1},
    "model_family": {"enum": ["Mistral", "Phi"]},
    "item_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "response_format_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider_response_id": {"type": "null"},
    "routed_provider": {"const": "LOCAL_MLX"},
    "system_fingerprint": {"type": "null"},
    "finish_reason": {"type": ["string", "null"]},
    "request_started_at_utc": {"type": "string", "format": "date-time"},
    "response_received_at_utc": {"type": "string", "format": "date-time"},
    "transport_status": {"enum": ["OK", "ERROR"]},
    "transport_error": {"type": ["string", "null"]},
    "raw_response_text": {"type": ["string", "null"]},
    "raw_response_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "parse_status": {
      "enum": ["OK", "JSON_SYNTAX_ERROR", "SCHEMA_ERROR", "SEMANTIC_ERROR", "TRANSPORT_ERROR"]
    },
    "parse_error_detail": {"type": ["string", "null"]},
    "raw_decision": {"type": ["object", "null"]},
    "postgate_decision": {"type": "null"},
    "latency_ms": {"type": "number", "minimum": 0},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": "null"},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "actual_cost_usd": {"type": "null"},
    "cost_status": {"const": "UNKNOWN"},
    "evidence_ceiling": {"const": "COMPUTATIONAL"}
  }
}
