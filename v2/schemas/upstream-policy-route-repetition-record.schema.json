{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/claimpromotebench/upstream-policy-route-repetition-record.schema.json",
  "title": "UpstreamPolicyRouteRepetitionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "frozen_plan_commit",
    "schedule_sha256",
    "packet_sha256",
    "sequence",
    "cell_id",
    "repetition",
    "lane_id",
    "provider",
    "model_requested",
    "model_returned",
    "model_family",
    "routed_provider",
    "item_id",
    "pair_id",
    "request_sha256",
    "prompt_sha256",
    "response_contract_sha256",
    "finish_reason",
    "request_started_at_utc",
    "response_received_at_utc",
    "transport_status",
    "transport_error",
    "raw_response_text",
    "raw_response_sha256",
    "action_extraction_status",
    "extracted_action",
    "parse_status",
    "parse_error_detail",
    "full_decision",
    "latency_ms",
    "usage",
    "billing_mode",
    "provider_response_id_retained",
    "hidden_reasoning_retained",
    "evidence_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "study_id": {"type": "string", "minLength": 1},
    "frozen_plan_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "schedule_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "packet_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 143},
    "cell_id": {"type": "string", "minLength": 1},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
    "lane_id": {"type": "string", "minLength": 1},
    "provider": {"const": "OpenCode Go"},
    "model_requested": {"enum": ["qwen3.7-max", "deepseek-v4-flash"]},
    "model_returned": {"type": ["string", "null"]},
    "model_family": {"enum": ["Qwen", "DeepSeek"]},
    "routed_provider": {"type": ["string", "null"]},
    "item_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "response_contract_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "finish_reason": {"type": ["string", "null"]},
    "request_started_at_utc": {"type": "string", "format": "date-time"},
    "response_received_at_utc": {"type": "string", "format": "date-time"},
    "transport_status": {"enum": ["OK", "ERROR"]},
    "transport_error": {"type": ["string", "null"]},
    "raw_response_text": {"type": ["string", "null"]},
    "raw_response_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "action_extraction_status": {"enum": ["EXTRACTED", "UNEXTRACTABLE"]},
    "extracted_action": {"type": ["string", "null"], "enum": ["ALLOW", "HOLD", null]},
    "parse_status": {
      "enum": [
        "OK",
        "JSON_SYNTAX_ERROR",
        "SCHEMA_ERROR",
        "SEMANTIC_ERROR",
        "TRANSPORT_ERROR"
      ]
    },
    "parse_error_detail": {"type": ["string", "null"]},
    "full_decision": {"type": ["object", "null"]},
    "latency_ms": {"type": "number", "minimum": 0},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "billing_mode": {"const": "PREEXISTING_OPENCODE_GO_ALLOWANCE"},
    "provider_response_id_retained": {"const": false},
    "hidden_reasoning_retained": {"const": false},
    "evidence_ceiling": {"const": "TIME_STAMPED_ROUTE_REPETITION"}
  }
}
