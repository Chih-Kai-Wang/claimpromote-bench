{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/claimpromotebench/route-smoke-run-record.schema.json",
  "title": "ClaimPromoteBenchRouteSmokeRunRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "frozen_plan_commit",
    "packet_sha256",
    "dataset_manifest_sha256",
    "phase",
    "lane_id",
    "provider",
    "model_requested",
    "model_returned",
    "model_identity_status",
    "item_id",
    "pair_id",
    "request_sha256",
    "prompt_sha256",
    "response_contract_sha256",
    "finish_reason",
    "request_started_at_utc",
    "response_received_at_utc",
    "transport_status",
    "transport_error",
    "raw_response_text",
    "raw_response_sha256",
    "parse_status",
    "parse_error_detail",
    "raw_decision",
    "latency_ms",
    "usage",
    "actual_cost_usd",
    "cost_status",
    "evidence_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "study_id": {"type": "string", "minLength": 1},
    "frozen_plan_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "packet_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dataset_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "phase": {"const": "full"},
    "lane_id": {"type": "string", "minLength": 1},
    "provider": {"const": "OpenCode Go"},
    "model_requested": {"const": "ox-alpha-free"},
    "model_returned": {"type": ["string", "null"]},
    "model_identity_status": {"const": "UNDISCLOSED_STEALTH_MODEL"},
    "item_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "response_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "finish_reason": {"type": ["string", "null"]},
    "request_started_at_utc": {"type": "string", "format": "date-time"},
    "response_received_at_utc": {"type": "string", "format": "date-time"},
    "transport_status": {"enum": ["OK", "ERROR"]},
    "transport_error": {"type": ["string", "null"]},
    "raw_response_text": {"type": ["string", "null"]},
    "raw_response_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "parse_status": {
      "enum": [
        "OK",
        "JSON_SYNTAX_ERROR",
        "SCHEMA_ERROR",
        "SEMANTIC_ERROR",
        "TRANSPORT_ERROR"
      ]
    },
    "parse_error_detail": {"type": ["string", "null"]},
    "raw_decision": {"type": ["object", "null"]},
    "latency_ms": {"type": "number", "minimum": 0},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "actual_cost_usd": {"const": 0.0},
    "cost_status": {"const": "OFFICIAL_FREE_ROUTE_LISTING"},
    "evidence_ceiling": {"const": "TIME_STAMPED_ROUTE_SMOKE_ONLY"}
  }
}
