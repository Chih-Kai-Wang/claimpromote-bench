{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chih-Kai-Wang/claimpromote-bench/schemas/evidence.schema.json",
  "title": "Evidence",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variables"],
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "lower", "upper", "lower_inclusive", "upper_inclusive"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "lower": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
              "upper": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
              "lower_inclusive": {"type": "boolean"},
              "upper_inclusive": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "type", "provenance", "artifact_path", "artifact_hash", "scope",
    "dependencies", "tool_exit", "verifier_result", "timestamp"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "type": {"enum": ["DEPENDENCY", "COMPUTATION", "FORMAL_CERTIFICATE", "REVIEW", "CONTRADICTION", "ARTIFACT"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_role", "run_id", "environment_sha256", "cold_start"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "actor_role": {"enum": ["CLAIM_AUTHOR", "TOOL", "INDEPENDENT_REVIEWER"]},
        "run_id": {"type": "string", "minLength": 1},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "cold_start": {"type": "boolean"}
      }
    },
    "artifact_path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))artifacts/[A-Za-z0-9._/-]+$"},
    "artifact_hash": {"$ref": "#/$defs/sha256"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement_sha256"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "statement_sha256": {"$ref": "#/$defs/sha256"},
        "domain": {"$ref": "#/$defs/domain"},
        "protocol_id": {"type": "string", "minLength": 1},
        "protocol_version": {"type": "string", "minLength": 1},
        "repetitions": {"type": "integer", "minimum": 0},
        "preregistered": {"type": "boolean"},
        "precision_bits": {"type": "integer", "minimum": 1},
        "contradiction_status": {"enum": ["OPEN", "RESOLVED"]},
        "verifier": {"type": "string", "minLength": 1},
        "toolchain_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
    },
    "tool_exit": {"type": ["integer", "null"]},
    "verifier_result": {"enum": ["PASS", "FAIL", "NOT_RUN", "UNKNOWN"]},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
