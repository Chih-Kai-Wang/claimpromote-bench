{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f0909172434/claimpromote-bench/schemas/run-record-v2.schema.json",
  "title": "RunRecordV2",
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_status", "computation_status", "formal_status", "review_status"],
      "properties": {
        "research_status": {"enum": ["PROPOSED", "OPEN", "RESOLVED"]},
        "computation_status": {"enum": ["NONE", "COMPUTATIONAL"]},
        "formal_status": {"enum": ["NONE", "FORMALLY_CERTIFIED"]},
        "review_status": {"enum": ["UNREVIEWED", "INDEPENDENTLY_VERIFIED"]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "proposed_state",
        "p_admissible",
        "used_evidence_ids",
        "reason_codes",
        "missing_evidence_ids"
      ],
      "properties": {
        "action": {"enum": ["ALLOW", "HOLD", "DEMOTE", "ESCALATE"]},
        "proposed_state": {"$ref": "#/$defs/state"},
        "p_admissible": {"type": "number", "minimum": 0, "maximum": 1},
        "used_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "missing_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "model_id",
    "model_artifact_sha256",
    "prompt_arm",
    "decoding_mode",
    "seed",
    "prompt_sha256",
    "response_format_sha256",
    "raw_response_text",
    "raw_response_sha256",
    "parse_status",
    "parse_error_detail",
    "raw_decision",
    "postgate_decision",
    "latency_ms",
    "output_tokens",
    "verifier_calls",
    "hardware"
  ],
  "properties": {
    "item_id": {"type": "string"},
    "model_id": {"type": "string"},
    "model_artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "quantization": {"type": ["string", "null"]},
    "runtime_commit": {"type": ["string", "null"]},
    "prompt_arm": {"const": "ledger_verifier"},
    "decoding_mode": {"enum": ["free", "json_schema"]},
    "seed": {"type": "integer"},
    "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "response_format_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "raw_response_text": {"type": "string"},
    "raw_response_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parse_status": {
      "enum": ["OK", "JSON_SYNTAX_ERROR", "SCHEMA_ERROR", "SEMANTIC_ERROR"]
    },
    "parse_error_detail": {"type": ["string", "null"]},
    "raw_decision": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/decision"}
      ]
    },
    "postgate_decision": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/decision"}
      ]
    },
    "latency_ms": {"type": "number", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "verifier_calls": {"type": "integer", "minimum": 0},
    "hardware": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"parse_status": {"const": "OK"}}},
      "then": {
        "properties": {
          "parse_error_detail": {"type": "null"},
          "raw_decision": {"type": "object"},
          "postgate_decision": {"type": "object"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "parse_status": {
            "enum": ["JSON_SYNTAX_ERROR", "SCHEMA_ERROR", "SEMANTIC_ERROR"]
          }
        }
      },
      "then": {
        "properties": {
          "parse_error_detail": {"type": "string"},
          "raw_decision": {"type": "null"},
          "postgate_decision": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"decoding_mode": {"const": "free"}}},
      "then": {"properties": {"response_format_sha256": {"type": "null"}}}
    },
    {
      "if": {"properties": {"decoding_mode": {"const": "json_schema"}}},
      "then": {
        "properties": {
          "response_format_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
