{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f0909172434/claimpromote-bench/schemas/benchmark-author-item.schema.json",
  "title": "BenchmarkAuthorItem",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["research_status", "computation_status", "formal_status", "review_status"],
      "properties": {
        "research_status": {"enum": ["PROPOSED", "OPEN", "RESOLVED"]},
        "computation_status": {"enum": ["NONE", "COMPUTATIONAL"]},
        "formal_status": {"enum": ["NONE", "FORMALLY_CERTIFIED"]},
        "review_status": {"enum": ["UNREVIEWED", "INDEPENDENTLY_VERIFIED"]}
      }
    },
    "domain": {
      "type": "object", "additionalProperties": false, "required": ["variables"],
      "properties": {"variables": {"type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "lower", "upper", "lower_inclusive", "upper_inclusive"],
        "properties": {
          "name": {"type": "string", "minLength": 1}, "lower": {"type": "string"}, "upper": {"type": "string"},
          "lower_inclusive": {"type": "boolean"}, "upper_inclusive": {"type": "boolean"}
        }
      }}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "provenance", "artifact_path", "artifact_hash", "scope", "dependencies", "tool_exit", "verifier_result", "timestamp"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "type": {"enum": ["DEPENDENCY", "COMPUTATION", "FORMAL_CERTIFICATE", "REVIEW", "CONTRADICTION", "ARTIFACT"]},
        "provenance": {"type": "object", "additionalProperties": false, "required": ["actor_id", "actor_role", "run_id", "environment_sha256", "cold_start"], "properties": {
          "actor_id": {"type": "string"}, "actor_role": {"enum": ["CLAIM_AUTHOR", "TOOL", "INDEPENDENT_REVIEWER"]},
          "run_id": {"type": "string"}, "environment_sha256": {"$ref": "#/$defs/sha256"}, "cold_start": {"type": "boolean"}
        }},
        "artifact_path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))artifacts/[A-Za-z0-9._/-]+$"},
        "artifact_hash": {"$ref": "#/$defs/sha256"},
        "scope": {"type": "object", "additionalProperties": false, "required": ["claim_id"], "properties": {
          "claim_id": {"type": "string"}, "statement_sha256": {"$ref": "#/$defs/sha256"}, "domain": {"$ref": "#/$defs/domain"},
          "protocol_id": {"type": "string"}, "protocol_version": {"type": "string"}, "repetitions": {"type": "integer", "minimum": 0},
          "preregistered": {"type": "boolean"}, "precision_bits": {"type": "integer", "minimum": 1},
          "contradiction_status": {"enum": ["OPEN", "RESOLVED"]}, "verifier": {"type": "string"},
          "toolchain_lock_sha256": {"$ref": "#/$defs/sha256"}
        }},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "tool_exit": {"type": ["integer", "null"]}, "verifier_result": {"enum": ["PASS", "FAIL", "NOT_RUN", "UNKNOWN"]},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "proposed_state", "p_admissible", "used_evidence_ids", "reason_codes", "missing_evidence_ids", "minimal_missing_evidence"],
      "properties": {
        "action": {"enum": ["ALLOW", "HOLD", "DEMOTE", "ESCALATE"]}, "proposed_state": {"$ref": "#/$defs/state"},
        "p_admissible": {"type": "number", "minimum": 0, "maximum": 1},
        "used_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "missing_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "minimal_missing_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "pair_id", "split", "family", "claim_text", "policy_id", "policy_version", "claim_context", "current_state", "current_state_basis", "requested_transition", "evidence", "gold"],
  "properties": {
    "schema_version": {"const": "1.0.0-alpha"}, "id": {"type": "string", "pattern": "^alpha-[a-z]+-[0-9]{2}-[ab]$"},
    "pair_id": {"type": "string", "pattern": "^alpha-[a-z]+-[0-9]{2}$"}, "split": {"const": "alpha"},
    "family": {"enum": ["DEPENDENCY", "NUMERICAL", "RUNTIME", "STALE_CONTRADICTION", "PROVENANCE", "FORMAL"]},
    "claim_text": {"type": "string", "minLength": 1}, "policy_id": {"const": "math-evidence-transition"},
    "policy_version": {"const": "1.0.0-alpha"},
    "claim_context": {"type": "object", "additionalProperties": false, "required": ["claim_id", "author_id", "author_environment_sha256", "statement_sha256"], "properties": {
      "claim_id": {"type": "string"}, "author_id": {"type": "string"}, "author_environment_sha256": {"$ref": "#/$defs/sha256"},
      "statement_sha256": {"$ref": "#/$defs/sha256"}, "bound_artifact_sha256": {"$ref": "#/$defs/sha256"}, "required_domain": {"$ref": "#/$defs/domain"}
    }},
    "current_state": {"$ref": "#/$defs/state"},
    "current_state_basis": {"type": "object", "additionalProperties": false, "properties": {
      "research_status": {"type": "array", "items": {"type": "string"}}, "computation_status": {"type": "array", "items": {"type": "string"}},
      "formal_status": {"type": "array", "items": {"type": "string"}}, "review_status": {"type": "array", "items": {"type": "string"}}
    }},
    "requested_transition": {"type": "object", "additionalProperties": false, "required": ["target_state", "basis_evidence_ids"], "properties": {
      "target_state": {"$ref": "#/$defs/state"}, "basis_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
    }},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "gold": {"$ref": "#/$defs/decision"}
  }
}
