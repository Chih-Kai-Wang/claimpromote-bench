{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chih-Kai-Wang/claimpromote-bench/schemas/run-contribution.schema.json",
  "title": "RunContribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "contributor",
    "dataset_gold_file",
    "dataset_manifest_sha256",
    "run_file",
    "run_file_sha256",
    "expected_run",
    "license",
    "consent",
    "reproduction"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contribution_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_login", "attestation"],
      "properties": {
        "github_login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "attestation": {
          "const": true
        }
      }
    },
    "dataset_gold_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9._/-]+\\.jsonl$"
    },
    "dataset_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9._/-]+\\.jsonl$"
    },
    "run_file_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expected_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_artifact_sha256",
        "quantization",
        "runtime_commit",
        "arm",
        "seed",
        "hardware"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "model_artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "quantization": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "runtime_commit": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "arm": {
          "enum": [
            "narrative",
            "ledger",
            "ledger_verifier",
            "ledger_verifier_gate"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "hardware": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    },
    "license": {
      "const": "MIT"
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redistribution",
        "public_attribution",
        "contains_secrets",
        "contains_personal_data",
        "terms_accepted"
      ],
      "properties": {
        "redistribution": {
          "const": true
        },
        "public_attribution": {
          "const": true
        },
        "contains_secrets": {
          "const": false
        },
        "contains_personal_data": {
          "const": false
        },
        "terms_accepted": {
          "const": true
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "runtime", "network_access"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source_revision": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "network_access": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    }
  }
}
